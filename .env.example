# Copy this file to backend/.env and fill in your values.
# .env is gitignored and must NEVER be committed.

# Required for Phase 3 AI explanations.
# Get your key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Required in any non-local deployment. Callers must send this value in the
# X-API-Key header on every /api/v1/* request (see backend/main.py). If left
# unset, auth is DISABLED (only acceptable for local/dev use) and a warning
# is logged at startup. Generate a long random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=your_long_random_api_key_here

# Comma-separated list of origins allowed to call this API from a browser
# (CORS). Defaults to http://localhost:5173 for local frontend dev. Add your
# deployed frontend URL(s) in production, e.g.:
#   ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# Only set to "true" if this app sits behind a proxy/load balancer that you
# control and that always OVERWRITES (never appends to) the X-Forwarded-For
# header before it reaches this app. When true, the first IP in that header
# is used for rate-limiting instead of the direct socket peer. Leave false
# (or unset) if the app is reachable directly, or you don't fully trust the
# upstream proxy — otherwise the rate limiter can be bypassed by spoofing a
# fresh IP on every request.
TRUSTED_PROXY=false

# Set if you plan to run multiple Uvicorn workers or multiple backend
# instances (e.g. WORKERS=4 passed to `uvicorn --workers`). This only
# triggers a startup warning — the in-memory rate limiter and result caches
# in main.py are per-process and do NOT coordinate across workers/instances.
# For correct global rate limiting behind multiple workers/replicas, replace
# them with a Redis-backed limiter instead of just setting this variable.
WORKERS=1
