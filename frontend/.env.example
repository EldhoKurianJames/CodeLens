VITE_API_URL=http://127.0.0.1:8000

# Must match the backend's API_KEY env var. Required once the backend has
# API_KEY set (recommended for any non-local deployment) — sent as the
# X-API-Key header on every /api/v1/* request. Leave blank only if the
# backend also has no API_KEY configured (local/dev mode).
VITE_API_KEY=your_api_key_here
